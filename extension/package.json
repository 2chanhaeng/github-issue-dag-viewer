{
  "name": "issue-atlas",
  "displayName": "Issue Atlas",
  "description": "Explore GitHub issue dependencies as an interactive directed graph inside VS Code.",
  "version": "1.1.1",
  "publisher": "2chanhaeng",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ccheney/github-issue-dag-viewer.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "github",
    "issues",
    "dependencies",
    "dag",
    "graph"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onWebviewPanel:issueAtlas.graph"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "issueAtlas.openGraph",
        "title": "Open Issue Dependency Graph",
        "category": "Issue Atlas",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "issueAtlas.openRepository",
        "title": "Open Repository…",
        "category": "Issue Atlas",
        "icon": "$(repo)"
      },
      {
        "command": "issueAtlas.openDemo",
        "title": "Explore Demo",
        "category": "Issue Atlas",
        "icon": "$(beaker)"
      },
      {
        "command": "issueAtlas.refreshRepositories",
        "title": "Refresh Repositories",
        "category": "Issue Atlas",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "issueAtlas",
          "title": "Issue Atlas",
          "icon": "media/issue-atlas.svg"
        }
      ]
    },
    "views": {
      "issueAtlas": [
        {
          "id": "issueAtlas.repositories",
          "name": "Repositories",
          "icon": "media/issue-atlas.svg",
          "contextualTitle": "Issue Atlas"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "issueAtlas.repositories",
        "contents": "No github.com remotes were found in this workspace.\n[Open Repository](command:issueAtlas.openRepository)\n[Explore Demo](command:issueAtlas.openDemo)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "issueAtlas.openRepository",
          "when": "view == issueAtlas.repositories",
          "group": "navigation@1"
        },
        {
          "command": "issueAtlas.refreshRepositories",
          "when": "view == issueAtlas.repositories",
          "group": "navigation@2"
        },
        {
          "command": "issueAtlas.openDemo",
          "when": "view == issueAtlas.repositories",
          "group": "issueAtlas@1"
        }
      ],
      "commandPalette": [
        {
          "command": "issueAtlas.refreshRepositories",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Issue Atlas",
      "properties": {
        "issueAtlas.authentication.provider": {
          "type": "string",
          "enum": [
            "auto",
            "githubCli",
            "vscode"
          ],
          "enumDescriptions": [
            "Use GitHub CLI when it is installed and signed in; otherwise sign in with your VS Code GitHub account.",
            "Always use GitHub CLI. Requests run through `gh api graphql`, so Issue Atlas never handles a token.",
            "Always use the GitHub account signed in to VS Code."
          ],
          "default": "auto",
          "markdownDescription": "How Issue Atlas authenticates its read-only GitHub GraphQL requests. No personal access token is needed."
        },
        "issueAtlas.githubCli.path": {
          "type": "string",
          "default": "gh",
          "scope": "machine",
          "markdownDescription": "The GitHub CLI executable. Use an absolute path when `gh` is not on the `PATH` that VS Code inherits."
        }
      }
    }
  }
}
